# HOPEBI Frontend Environment Configuration

# Backend REST API endpoint (default: /api/v1 for reverse proxy/vite proxy)
VITE_API_BASE_URL=/api/v1

# Official Google OAuth Web Client ID
# Obtain free from: https://console.cloud.google.com/apis/credentials
# Leave empty for local simulation mode, or paste your client ID for live production Google popup!
VITE_GOOGLE_CLIENT_ID=448639070474-10a8pnusns4r5tlec9lmi6df8v18tkqm.apps.googleusercontent.com

# Enable developer sandbox credentials & dev helper badges (true in dev, false in production)
VITE_ENABLE_DEV_SANDBOX=false
